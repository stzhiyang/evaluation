<!-- 
算法耗时计算启动文件
Timing Calculation Launch File

功能说明:
- 读取指定的 CSV 文件，计算各算法的平均耗时
- 要求每个 CSV 文件至少有 100 组有效数据
- 有效数据条件：除 Timestamp 和 PointCount 外，所有时间变量 > 0.001 秒
- 计算方法：取倒数 100 组有效数据的 TotalTime 平均值
- 生成带时间戳的 TXT 报告文件

使用方法:
1. 修改下方的 CSV 文件路径，指定四个算法的 timing 文件
2. 修改输出目录路径（可选）
3. 启动: roslaunch evaluation timing_calculation.launch
4. 查看结果: evaluation/results/timing_reports/timing_report_YYYYMMDD_HHMMSS.txt
-->

<launch>
    <!-- 耗时计算节点 -->
    <node 
        name="timing_calculator" 
        pkg="evaluation" 
        type="calculate_timing.py" 
        output="screen"
        required="true">
        
        <!-- 配置四个算法的 CSV 文件路径 -->
        <!-- 请根据实际情况修改这些路径 -->
        <rosparam param="csv_files">
            LDOT: "/home/st/LDOT_ws/src/LDOT/ldot_detector/timing/test_ldot_timing_20260126_112830_066.csv"
            M-detector: "/home/st/M_detector/src/M-detector/timing/test_mdetector_timing_20260126_112351_290.csv"
            LV-DOT: "/home/st/ODOT/src/LV-DOT/onboard_detector/timing/test_lvdot_timing_20260126_113725_406.csv"
            FAPP: "/home/st/FAPP/src/FAPP/src/mot_mapping/timing/test_fapp_timing_20260126_114446_205.csv"
        </rosparam>
        
        <!-- 输出目录配置 -->
        <!-- 报告将保存为: output_dir/timing_report_YYYYMMDD_HHMMSS.txt -->
        <param name="output_dir" value="$(find evaluation)/results/timing_eval" />
        
    </node>

</launch>
